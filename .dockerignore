# Root build context is used by payment-service and Alipay Adapter Dockerfiles.
# Keep required directories, ignore everything else.
*
!payment-service/**
!blockchain-adapter/**
!did-service/**
!alipay-adapter/**

# Exclude heavy artifacts inside included dirs
payment-service/.git
payment-service/.git/**
payment-service/vendor
payment-service/vendor/**
payment-service/*.exe
payment-service/**/bin
payment-service/**/dist
payment-service/**/tmp
payment-service/**/coverage
payment-service/.cursor
payment-service/.cursor/**
payment-service/.idea
payment-service/.idea/**

blockchain-adapter/.git
blockchain-adapter/.git/**
blockchain-adapter/vendor
blockchain-adapter/vendor/**
blockchain-adapter/*.exe
blockchain-adapter/**/bin
blockchain-adapter/**/dist
blockchain-adapter/**/tmp
blockchain-adapter/**/coverage
blockchain-adapter/.cursor
blockchain-adapter/.cursor/**
blockchain-adapter/.idea
blockchain-adapter/.idea/**

did-service/.git
did-service/.git/**
did-service/vendor
did-service/vendor/**
did-service/*.exe
did-service/**/bin
did-service/**/dist
did-service/**/tmp
did-service/**/coverage
did-service/.cursor
did-service/.cursor/**
did-service/.idea
did-service/.idea/**

alipay-adapter/.git
alipay-adapter/.git/**
alipay-adapter/vendor
alipay-adapter/vendor/**
alipay-adapter/*.exe
alipay-adapter/**/bin
alipay-adapter/**/dist
alipay-adapter/**/tmp
alipay-adapter/**/coverage
alipay-adapter/.cursor
alipay-adapter/.cursor/**
alipay-adapter/.idea
alipay-adapter/.idea/**
