# Export these in the process running payment-service; this file is a template.
FIAT_HTTP_ADDR=127.0.0.1:8092
FIAT_INTERNAL_TOKEN=replace-with-at-least-24-random-characters
FIAT_PAYMENT_MODE=local
# For alipay_sandbox only. Use sandbox keys, never production keys.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=https://your-test-host.example/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://your-test-host.example/payathon
