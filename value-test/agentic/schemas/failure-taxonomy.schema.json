{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stablepay-agentic/failure-taxonomy.schema.json",
  "title": "StablePay Agentic Failure Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "passed",
    "primary_error_category",
    "secondary_error_tags",
    "failure_summary",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "passed": {
      "type": "boolean"
    },
    "primary_error_category": {
      "type": "string",
      "enum": [
        "none",
        "wrong_tool_selection",
        "wrong_argument",
        "missing_confirmation",
        "local_state_mismatch",
        "backend_security_rejection",
        "mq_async_consistency_timeout",
        "insufficient_balance",
        "environment_flakiness",
        "judge_bug"
      ]
    },
    "secondary_error_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "recoverable",
          "non_deterministic",
          "host_specific",
          "prompt_induced",
          "schema_induced",
          "tool_description_induced",
          "fixture_induced",
          "timeout_induced"
        ]
      },
      "uniqueItems": true
    },
    "failure_summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "suggested_fix_direction": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "properties": {
          "primary_error_category": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "passed": {
            "const": false
          }
        },
        "required": [
          "passed"
        ]
      },
      "then": {
        "properties": {
          "primary_error_category": {
            "not": {
              "const": "none"
            }
          }
        }
      }
    }
  ]
}
