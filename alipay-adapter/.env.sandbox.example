ALIPAY_ADAPTER_RPC_PORT=8086
# Optional website page-pay app. Leave empty for Machine Pay only.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay/app-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay/alipay-public.pem
ALIPAY_NOTIFY_URL=https://merchant.example/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://merchant.example/payathon

# Host directory mounted read-only at /run/secrets/alipay by docker-compose.
ALIPAY_KEYS_DIR=/absolute/path/on/host/containing/key-files

# Optional Alipay AI Pay Machine Pay credentials. The service must be registered
# and approved in the AI Pay console before the precreate API can be used.
# Machine Pay can reuse the existing sandbox app above. Set AIPAY_APP_ID and
# its *_FILE paths only if AI Pay uses a different application/key pair.
AIPAY_APP_ID=
AIPAY_MACHINE_PAY_SERVICE_ID=
AIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
AIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay/app-private.pem
AIPAY_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay/alipay-public.pem
# Console-provided base64 key values are accepted as runtime env vars.
# Prefer key files and keep their directory outside version control.
AIPAY_PRIVATE_KEY=
AIPAY_ALIPAY_PUBLIC_KEY=
AIPAY_MACHINE_PAY_ENABLED=false
