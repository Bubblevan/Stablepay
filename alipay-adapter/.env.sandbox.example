ALIPAY_ADAPTER_RPC_PORT=8086
ALIPAY_APP_ID=replace-with-sandbox-app-id
ALIPAY_SELLER_ID=replace-with-sandbox-seller-id
ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay/app-private.pem
ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay/alipay-public.pem
ALIPAY_NOTIFY_URL=https://merchant.example/api/payments/alipay/notify
ALIPAY_RETURN_URL=https://merchant.example/payathon
